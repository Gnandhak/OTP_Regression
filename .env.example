# Configure these as Copado job environment variables or secrets.
# Outlook / Microsoft 365 SMTP submission settings:
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=your.name@yourcompany.com
SMTP_PASSWORD=replace-with-app-password-or-approved-secret
SMTP_FROM=your.name@yourcompany.com
SMTP_USE_TLS=true

# Salesforce UI automation variables.
SF_LOGIN_URL=https://homeservehs--sit.sandbox.my.salesforce.com/
SF_BROWSER=chrome
SF_HEADLESS=false
SF_MANUAL_SSO=true
SF_LOGIN_TIMEOUT=180
SF_PROFILE_DIR=.runtime/salesforce-profile